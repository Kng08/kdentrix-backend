# ── MongoDB Atlas
# Get this from: MongoDB Atlas → Connect → Drivers → Copy connection string
# Replace <password> and <dbname> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kdentrix?retryWrites=true&w=majority

# ── JWT Secret
# Use any long random string (e.g. generate at: https://randomkeygen.com)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_kdentrix2024

# ── Email (Gmail)
# 1. Use your Gmail address below
# 2. Enable 2FA on your Google account
# 3. Go to Google Account → Security → App Passwords → Generate one
# 4. Paste that 16-char App Password as EMAIL_PASS (NOT your real Gmail password)
EMAIL_USER=kingsleykaine46@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ── Admin notification email (receives new booking alerts)
ADMIN_EMAIL=kingsleykaine46@gmail.com

# ── Paystack
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Use TEST keys during development, LIVE keys for production
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend URL (your deployed site URL)
# During development: http://localhost:3000
# After deploying to Render: https://kdentrix.onrender.com
FRONTEND_URL=https://kdentrix.onrender.com

# ── Port (Render sets this automatically; keep 3000 for local dev)
PORT=3000
